# Marceltov/engineering-conventions: code/formatting.md. Copy into a project's root.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 160

[*.py]
indent_size = 4

# MkDocs Markdown nests lists and admonitions by four spaces.
[docs/**.md]
indent_size = 4
