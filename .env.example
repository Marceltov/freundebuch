# Copy to .env. Everything is optional unless noted; empty means the default.

# The address clients reach freundebuch at (OAuth issuer, links). Needed behind a reverse proxy.
PUBLIC_URL=https://freundebuch.example.com

# Signs OAuth tokens and sign-in cookies: at least 32 bytes (openssl rand -hex 32). Unset: generated once into
# ${DATA_DIR}/secret. Changing it signs out every browser and every connected Claude (the only revocation, ADR 0003).
FREUNDEBUCH_SECRET=

# Sign-in through authentik (any OIDC provider); required, there is no other way in. Who may use the instance is decided
# there. Register ${PUBLIC_URL}/api/oidc/callback as the redirect URI.
FREUNDEBUCH_OIDC_ISSUER=https://authentik.example.com/application/o/freundebuch/
FREUNDEBUCH_OIDC_CLIENT_ID=
FREUNDEBUCH_OIDC_CLIENT_SECRET=
# Optional extra restriction, comma-separated: addresses or @domain (both need a verified email). Empty means * (anyone authentik lets in).
FREUNDEBUCH_OIDC_ALLOW=

# Behind a reverse proxy that sets X-Forwarded-For/-Proto/-Host: 1. Otherwise those headers are ignored.
FREUNDEBUCH_TRUST_PROXY=

# Failed sign-ins per minute and client IP before it has to wait. Default 60; 0 turns the limit off.
FREUNDEBUCH_RATE_LIMIT=

# Time of day (HH:MM, local) the daily reminders go out. Default 08:00.
FREUNDEBUCH_NOTIFY_AT=08:00

# The in-app chat ("Erzählen"): an Anthropic API key turns it on; without one the app has no chat.
FREUNDEBUCH_ANTHROPIC_API_KEY=
# The Claude model it uses. Default claude-sonnet-5-5.
FREUNDEBUCH_ANTHROPIC_MODEL=
# Messages each user may send the chat per day. Default 100.
FREUNDEBUCH_CHAT_DAILY_LIMIT=

# error, warn, info (default), debug or silent.
FREUNDEBUCH_LOG_LEVEL=info

# Birthdays and "today" are computed in this time zone.
TZ=Europe/Berlin
